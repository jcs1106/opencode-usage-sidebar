{
  "name": "@shaojc/opencode-usage-sidebar",
  "version": "0.1.0",
  "description": "OpenCode TUI sidebar for Go quota, token usage, cost estimates and live TPS",
  "type": "module",
  "license": "MIT",
  "author": "shaojc",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "usage",
    "quota",
    "tokens",
    "tps"
  ],
  "exports": {
    "./tui": "./tui.tsx"
  },
  "files": [
    "tui.tsx",
    "panel.tsx",
    "data.ts",
    "format.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "publishConfig": {
    "access": "public"
  }
}
