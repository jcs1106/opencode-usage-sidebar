    "panel.tsx",
    "data.ts",
    "format.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
