{
  "name": "@shaojc/opencode-usage-sidebar",
  "version": "0.2.0",
  "description": "OpenCode TUI sidebar for Go quota, token usage, cost estimates and live TPS",
  "type": "module",
  "license": "MIT",
  "author": "shaojc",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "usage",
    "quota",
    "tokens",
    "tps"
  ],
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "check:render": "npm exec --yes --package=bun@1.3.0 -- bun --conditions=browser scripts/render-check.mjs",
    "precheck:render": "npm run build",
    "verify": "npm test && npm run typecheck",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  }
}
