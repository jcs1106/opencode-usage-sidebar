{
  "name": "@shaojc/opencode-usage-sidebar",
  "version": "0.1.1",
  "description": "OpenCode TUI sidebar for Go quota, token usage, cost estimates and live TPS",
  "type": "module",
  "license": "MIT",
  "author": "shaojc",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "usage",
    "quota",
    "tokens",
    "tps"
  ],
  "exports": {
